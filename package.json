{
  "name": "ui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "ui.zyx.tw: the zyx.tw design system. Stock shadcn/ui, grayscale palette, plus my own components.",
  "scripts": {
    "dev": "next dev",
    "build": "shadcn build && next build",
    "registry:build": "shadcn build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:agent": "cd registry/zyx/agent && bun test model seal tools telemetry public-fetch.bun && tsx --test public-fetch.test.ts",
    "theme:check": "node scripts/check-theme.mjs",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "motion": "^12.38.0",
    "react-day-picker": "^10.0.1",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.14.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "@turbo/gen": "^2.8.1",
    "@ai-sdk/openai": "^4.0.83",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "ai": "^7.0.127",
    "undici": "^8.11.2",
    "zod": "^4.6.5",
    "@types/bun": "^1.4.2",
    "tsx": "^4.23.15",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
